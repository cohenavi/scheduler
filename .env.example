# Application Port (Host mapping for Docker & internal Express port)
APP_PORT=2800
PORT=2800

# Optional public URL override (e.g., https://schedule.example.com)
PUBLIC_BASE_URL=

# Timezone
TZ=America/Detroit

# PostgreSQL Configuration (Internal Compose Network Only)
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=scheduler

# Database URL (for local development outside Docker; Docker Compose constructs this automatically)
DATABASE_URL=postgresql://scheduler:changeme_strong_password@localhost:5432/scheduler?schema=public

# Authentication & Security
JWT_SECRET=changeme_replace_with_64_char_random_hex_string
ADMIN_PASSWORD=admin123

# Cookie Secure flag: 'auto' (uses X-Forwarded-Proto / req.secure), 'true', or 'false'
COOKIE_SECURE=auto

# Optional External Reverse-Proxy Docker Network (e.g., proxy_net for Nginx Proxy Manager / Caddy / Traefik)
# PROXY_NETWORK=proxy_net
